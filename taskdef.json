{
  "family": "learnflow-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::854698772872:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::854698772872:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "learnflow-api",
      "image": "854698772872.dkr.ecr.ap-south-2.amazonaws.com/learnflow/microservice:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "ENV",
          "value": "prod"
        },
        {
          "name": "AWS_REGION",
          "value": "ap-south-2"
        },
        {
          "name": "S3_BUCKET",
          "value": "learnflow-docs"
        },
        {
          "name": "USE_S3_STORAGE",
          "value": "true"
        },
        {
          "name": "DATABASE_URL",
          "value": "postgresql+psycopg://postgres:Learnflow123@document-mapping.cn2a2uaicp1r.ap-south-2.rds.amazonaws.com:5432/document-mapping"
        },
        {
          "name": "OPENAI_API_KEY",
          "value": "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"
        }
      ],
      
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/learnflow",
          "awslogs-region": "ap-south-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
