# RDS Database via SSH Tunnel (localhost:15432 -> RDS:5432)
database_url=postgresql+psycopg://postgres:Learnflow123@127.0.0.1:15432/document-mapping

# Explicit postgres settings (fallback)
postgres_host=127.0.0.1
postgres_port=15432
postgres_db=document-mapping
postgres_user=postgres
postgres_password=Learnflow123

# OpenAI API Key (REQUIRED)
openai_api_key=YOUR_OPENAI_API_KEY_HERE

# pgvector settings
pgvector_dimension=3072
pgvector_ivfflat_lists=100

# Application Settings
debug=false
log_level=INFO
api_host=0.0.0.0
api_port=8000
api_reload=true

# LLM Provider
llm_provider=openai

# Document Processing
chunk_size=1000
chunk_overlap=200
max_file_size_mb=50

# Storage (local for dev)
upload_dir=./uploads
temp_dir=./temp
use_s3_storage=false
